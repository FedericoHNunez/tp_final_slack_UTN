<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Confirma tu cuenta en Slak</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f4f5f7;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f4f5f7;
            padding: 40px 0;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .email-header {
            background: linear-gradient(135deg, #611f69 0%, #4a154b 100%);
            padding: 40px 30px;
            text-align: center;
        }

        .logo {
            color: #ffffff;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
            margin: 0;
        }

        .logo span {
            color: #e0a9ff;
        }

        .header-tag {
            display: inline-block;
            margin-top: 10px;
            background-color: rgba(255, 255, 255, 0.18);
            color: #f3d9fa;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding: 4px 14px;
            border-radius: 20px;
        }

        .email-body {
            padding: 40px 35px;
            color: #1d1c1d;
        }

        .greeting {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 12px 0;
            color: #1d1c1d;
        }

        .message {
            font-size: 16px;
            line-height: 1.6;
            color: #4a4a4a;
            margin: 0 0 20px 0;
        }

        .highlight {
            background-color: #f8f3fc;
            border-left: 4px solid #611f69;
            padding: 16px 20px;
            border-radius: 6px;
            margin: 25px 0;
            font-size: 14px;
            line-height: 1.5;
            color: #4a4a4a;
        }

        .highlight-warning {
            background-color: #fff9f0;
            border-left: 4px solid #ECB22E;
            padding: 16px 20px;
            border-radius: 6px;
            margin: 25px 0;
            font-size: 14px;
            line-height: 1.5;
            color: #614700;
        }

        .button-wrapper {
            text-align: center;
            margin: 32px 0;
        }

        .confirm-button {
            display: inline-block;
            background: linear-gradient(135deg, #611f69 0%, #4a154b 100%);
            color: #ffffff !important;
            text-decoration: none;
            padding: 14px 40px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.3px;
            box-shadow: 0 4px 12px rgba(97, 31, 105, 0.3);
            transition: all 0.3s ease;
        }

        .confirm-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(97, 31, 105, 0.4);
        }

        .token-box {
            background-color: #f6f8fa;
            border: 1px dashed #d1d5db;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            margin: 25px 0;
        }

        .token-label {
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .token-value {
            font-family: 'Courier New', monospace;
            font-size: 14px;
            color: #611f69;
            font-weight: 600;
            word-break: break-all;
        }

        .divider {
            height: 1px;
            background-color: #e5e7eb;
            margin: 30px 0;
        }

        .security-note {
            font-size: 13px;
            color: #6b7280;
            font-style: italic;
            margin: 20px 0 0 0;
            line-height: 1.5;
        }

        .footer {
            background-color: #fafafa;
            padding: 25px 35px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
        }

        .footer-text {
            font-size: 12px;
            color: #6b7280;
            margin: 0 0 8px 0;
            line-height: 1.5;
        }

        .footer-text:last-child {
            margin-bottom: 0;
        }

        .footer-link {
            color: #611f69;
            text-decoration: none;
            font-weight: 500;
        }

        .footer-link:hover {
            text-decoration: underline;
        }

        @media only screen and (max-width: 600px) {
            .email-wrapper {
                padding: 20px 10px;
            }

            .email-header {
                padding: 30px 20px;
            }

            .email-body {
                padding: 30px 20px;
            }

            .footer {
                padding: 20px;
            }

            .greeting {
                font-size: 20px;
            }

            .message {
                font-size: 15px;
            }

            .confirm-button {
                padding: 12px 30px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <div class="email-wrapper">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
                <td align="center">
                    <div class="email-container">

                        <!-- HEADER -->
                        <div class="email-header">
                            <h1 class="logo">slac<span>k</span></h1>
                            <div class="header-tag">Confirmación de cuenta</div>
                        </div>

                        <!-- BODY -->
                        <div class="email-body">
                            <h2 class="greeting">¡Hola, <%= userName %>! 👋</h2>
                            <p class="message">
                                Gracias por registrarte en <strong>Slack</strong>. Estamos muy contentos de tenerte con
                                nosotros.
                            </p>
                            <p class="message">
                                Para comenzar a usar tu cuenta, solo necesitamos confirmar que este correo electrónico
                                te pertenece. Haz clic en el botón de abajo para activar tu cuenta:
                            </p>

                            <!-- BOTÓN DE CONFIRMACIÓN -->
                            <div class="button-wrapper">
                                <a href="<%= url_backend %>/api/auth/verify-email/<%= token %>" class="confirm-button">
                                    ✨ Confirmar mi cuenta
                                </a>
                            </div>

                            <!-- AVISO INFORMATIVO -->
                            <div class="highlight">
                                🔒 <strong>Importante:</strong> Este enlace es personal e intransferible. Si no
                                solicitaste esta confirmación, puedes ignorar este correo de forma segura.
                            </div>

                            <div class="divider"></div>

                            <p class="security-note">
                                Este enlace expirará en <strong>24 horas</strong>. Después de ese tiempo, deberás
                                solicitar uno nuevo.
                            </p>
                        </div>

                        <!-- FOOTER -->
                        <div class="footer">
                            <p class="footer-text">
                                <%= new Date().getFullYear() %> Slack. Todos los derechos reservados.<br>
                                    Este correo fue enviado a <strong>
                                        <%= email %>
                                    </strong>
                            </p>
                            <p class="footer-text">
                                <a href="<%= url_backend %>" class="footer-link">Visitar sitio</a> ·
                                <a href="<%= url_backend %>/soporte" class="footer-link">Soporte</a> ·
                                <a href="<%= url_backend %>/privacidad" class="footer-link">Privacidad</a>
                            </p>
                        </div>

                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>